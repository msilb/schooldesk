{
  "name": "schooldesk",
  "version": "0.1.0",
  "private": true,
  "description": "A private, portable school dashboard for one family.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check:release": "tsx scripts/check-release.ts",
    "setup": "tsx scripts/setup.ts",
    "member:add": "tsx scripts/member.ts add",
    "member:remove": "tsx scripts/member.ts remove",
    "import": "tsx scripts/import.ts",
    "sync": "tsx scripts/sync.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "demo": "node scripts/demo.mjs",
    "test:http": "tsx scripts/smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:demo": "node scripts/build-demo.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.14",
    "better-sqlite3": "13.0.3",
    "kysely": "0.28.18",
    "lucide-react": "0.577.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.19",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
