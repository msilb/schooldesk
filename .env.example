# Private mode is the default. Demo mode ignores the private database completely.
SCHOOLDESK_MODE=private
BETTER_AUTH_URL=http://localhost:3000
# Generated by npm run setup; never commit populated environment files.
BETTER_AUTH_SECRET=
SCHOOLDESK_SYNC_TOKEN=

# SQLite is the local/container default. Set this for Vercel or PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/schooldesk?sslmode=require
# SCHOOLDESK_DATABASE=.data/schooldesk.sqlite

# Only the optional command-line importer uses this setting.
# SCHOOLDESK_SYNC_URL=https://your-schooldesk.example

# For a local-only production container without TLS. Use HTTPS on the internet.
# SCHOOLDESK_ALLOW_HTTP=true
